{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
      {
        "alignment": "left",
        "segments": [
          {
            "foreground": "#3EC669",
            "properties": {
              "style": "folder"
            },
            "style": "diamond",
            "template": "\ue5ff {{ .Path }}",
            "type": "path"
          },
          {
            "foreground": "#43CCEA",
            "foreground_templates": [
              "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
              "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
              "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
              "{{ if gt .Behind 0 }}#B388FF{{ end }}"
            ],
            "properties": {
              "branch_max_length": 25,
              "fetch_stash_count": true,
              "fetch_status": true,
              "fetch_upstream_icon": true
            },
            "style": "diamond",
            "template": " {{ .HEAD }} ",
            "type": "git"
          },
          {
            "foreground": "#E4F34A",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}",
            "type": "python"
          },
          {
            "foreground": "#7FD5EA",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue626{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
            "type": "go"
          },
          {
            "foreground": "#42E66C",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue718{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
            "type": "node"
          },
          {
            "foreground": "#E64747",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue791{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
            "type": "ruby"
          },
          {
            "foreground": "#E64747",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue738{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
            "type": "java"
          },
          {
            "foreground": "#9B6BDF",
            "properties": {
              "fetch_version": false
            },
            "style": "diamond",
            "template": "\ue624{{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
            "type": "julia"
          },
          {
            "type": "php",
            "style": "diamond",
            "properties": {
              "fetch_version": false
            },
            "template": "\ue73d {{ .Full }} "
          }
        ],
        "type": "prompt"
      },
      {
        "alignment": "left",
        "newline": true,
        "segments": [
          {
            "background": "#29315A",
            "foreground": "#E64747",
            "leading_diamond": "\ue0b6",
            "style": "diamond",
            "template": "{{ .UserName }} \u276f",
            "trailing_diamond": "\ue0b4",
            "type": "text"
          }
        ],
        "type": "prompt"
      }
    ],
    "console_title_template": "{{ .Folder }}",
    "final_space": true,
    "version": 2
  }